class overflow {
	basic() {
		def x = 5;
		def y = -x;
		def z = x + 2;
		return z;
	}

	addOverflow() {
		def a = 2147483647;
		def b = a + 1;
		return b;
	}

	negOverflow() {
		def c = -2147483647;
		def m = c - 1;
		def d = 0 - m;
		return d;
	}

	division() {
		def e = 0;
		def f = 5;
		def g = e / f;
		return g;
	}

	divByZero() {
		def x = 5;
		def y = 0;
		def z = x / y;
		return z;
	}

	mulOverflow() {
		def x = 50000;
		def y = 50000;
		def z = x * y;
		return z;
	}

	branches() {
		def x = 5;
		def y = 7;
		def z = 0;
		if (x < y)
			z = x + 1;
		else
			z = y + 1;
		return z;
	}

	refine(a) {
		def x = a;
		def y = 0;
		if (x < 10)
			y = x + 1;
		else
			y = x - 1;
		return y;
	}

	refineRange(a) {
		def x = a;
		def y = 0;
		if (x < 10)
			if (x > 0)
				y = x + 1;
		return y;
	}
}
